# Copy to .env beside docker-compose.yml and fill in. .env is gitignored;
# MAIL_API_KEY is a credential and must never be committed.
#
# Without both of these the server logs confirmation and reset links to its
# own log instead of mailing them, and says so on the boot line. That is
# fine for development and wrong for production: the log then contains
# bearer credentials.
#
# The provider is Resend (ADR 0007), reached over plain HTTPS with no extra
# package. MAIL_FROM has to be an address at a domain verified with them,
# which means the DNS records they hand you on claudeoflegends.com.
MAIL_API_KEY=
MAIL_FROM=Claude of Legends <no-reply@claudeoflegends.com>

# Optional Discord sign-in (ADR 0009): the Continue with Discord button
# that creates an account and signs it back in. Both come from one Discord
# application at https://discord.com/developers/applications, whose OAuth2
# redirect must be exactly PUBLIC_URL + /api/discord/callback. The scope
# asked for is `identify` and nothing else, and no token is ever stored.
#
# Without both of these, the routes answer "not configured", the client
# never offers the button, and the boot line says so.
# DISCORD_CLIENT_SECRET is a credential and must never be committed.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# The Forge's generation pipeline (ADR 0010, ADR 0011): a Tripo API key on
# a paid tier (free-tier outputs are Tripo-owned and non-commercial).
# Without it, finalize answers "not configured"; drafts and test drives
# work regardless. IMPORTANT: exposing generation to players requires
# Tripo's prior written authorization (their terms s. 3.2); obtain the
# agreement before opening the Forge publicly. GENERATION_PROVIDER=mock
# enables a keyless dev pipeline with placeholder assets (never set it in
# production). TRIPO_API_KEY is a credential and must never be committed.
TRIPO_API_KEY=

# The image model behind EVERY 2D generation (Tripo's advanced
# generate_image task): splash, iterations, model reference, icons.
# Default gpt_image_2, a quality-over-cost choice; other documented
# values include flux.1_kontext_pro, gemini_3_pro_image_preview,
# midjourney (docs.tripo3d.ai, advanced-image-generation).
TRIPO_IMAGE_MODEL=

# Forge tuning (plan-forge phase 8). Every knob is optional; unset or
# empty falls back to the default in parentheses. Quotas count a rolling
# window per account; zero disables that meter.
# CREATIONS_PER_WEEK (3): the weekly creation grant on the ledger.
# FORGE_DRAFT_CAP (50): drafts one account may hold.
# REPORT_TAKEDOWN_THRESHOLD (3): distinct accounts reporting one champion
#   before it is taken down pending review.
# GENERATIONS_PER_DAY (5): finalize chains one account may start per day,
#   the spend backstop under the weekly ledger.
# QUOTA_2D_PER_DAY (40): the splash and icon generation meter (one image
#   each); QUOTA_AGENT_PER_DAY (20): the agent meter, consumed when its
#   phase 4 surface lands.
# API_RATE_PER_MIN (120): blanket /api requests per address per minute;
#   the login throttle keeps its own sharper backoff.
# ART_HISTORY_CAP (12): 2D candidates kept per champion and kind; the
#   oldest unchosen fall off, the chosen one never does.
# ASSET_MAX_IMAGE_KB (4096) and ASSET_MAX_MODEL_KB (81920): per-champion
#   asset budgets (ADR 0010); an artifact over budget fails its job and
#   refunds the creation. A real five-clip baked GLB measured 58 MB, so
#   the model ceiling bounds abuse until compression tuning lands.
CREATIONS_PER_WEEK=
FORGE_DRAFT_CAP=
REPORT_TAKEDOWN_THRESHOLD=
GENERATIONS_PER_DAY=
QUOTA_2D_PER_DAY=
QUOTA_AGENT_PER_DAY=
API_RATE_PER_MIN=
ART_HISTORY_CAP=
ASSET_MAX_IMAGE_KB=
ASSET_MAX_MODEL_KB=

# Bots on the account (ADR 0013, docs/plan-bots.md). Optional like the
# Forge knobs; unset falls back to the default in parentheses.
# BOT_CAP (100): bots one account may hold, a hard abuse rail.
# BOT_DEPOSIT_CAP (3): bots one account may keep in the Arena at once,
#   the Arena's CPU bound.
BOT_CAP=
BOT_DEPOSIT_CAP=
