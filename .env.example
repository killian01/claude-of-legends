# Copy to .env next to compose.yaml and fill in. Never commit the copy.

# The name the certificate is issued for; its DNS A record must already point
# at this machine before the first "docker compose up".
DOMAIN=play.example.com

# Where the certificate authority sends expiry warnings. Optional but wise.
ACME_EMAIL=you@example.com

# Extra origins allowed to open a game socket, comma separated. Empty is right
# for a normal deploy: the client is served by the same host it connects to.
# Only fill this in when the client also lives somewhere else.
ALLOWED_ORIGINS=
